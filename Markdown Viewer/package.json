{
  "name": "markdown-editor",
  "private": true,
  "version": "3.2.1",
  "type": "module",
  "license": "MIT",
  "description": "A powerful native desktop markdown viewer and editor with real-time preview",
  "author": "Markdown Viewer Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/travelingbear/markdown-editor.git"
  },
  "homepage": "https://github.com/travelingbear/markdown-editor",
  "keywords": [
    "markdown",
    "editor",
    "viewer",
    "desktop",
    "tauri"
  ],
  "scripts": {
    "tauri": "tauri",
    "dev": "npm run tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "npm run tauri build",
    "build:web": "vite build",
    "preview:web": "vite preview --host 127.0.0.1 --port 1420",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:debug": "npm run tauri build -- --debug",
    "build:windows": "npm run tauri build -- --target x86_64-pc-windows-msvc",
    "build:macos": "npm run tauri build -- --target x86_64-apple-darwin",
    "build:linux": "npm run tauri build -- --target x86_64-unknown-linux-gnu",
    "build:all": "npm run build:windows && npm run build:macos && npm run build:linux",
    "clean": "npm run tauri build -- --clean",
    "version": "npm run tauri -- --version",
    "info": "npm run tauri info"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.3",
    "jsdom": "^30.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "~2.8.0",
    "@tauri-apps/plugin-dialog": "~2.3.0",
    "@tauri-apps/plugin-fs": "~2.4.0",
    "@tauri-apps/plugin-opener": "^2.2.3",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.9",
    "marked": "^12.0.2",
    "mermaid": "11.16.1"
  }
}
